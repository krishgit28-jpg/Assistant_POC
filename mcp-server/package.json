{
  "name": "pptist-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that exposes PPTist slide context as tools for OpenClaw",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build:sdk": "npm --prefix ../packages/sdk install && npm --prefix ../packages/sdk run build",
    "build": "npm run build:sdk && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pptist/sdk": "file:../packages/sdk",
    "onnxruntime-node": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.3.0"
  }
}
